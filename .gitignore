# Generated data. Each project's script under python/ rebuilds these; the
# committed deliverable is the SQLite database (sql/database/) or the Excel
# workbook (excel/), and the processed CSVs the Power BI models read.
sales_analytics_pipeline/python/data/raw/
sales_analytics_pipeline/python/data/processed/
customer_retention_behavior/python/data/raw/
customer_retention_behavior/python/data/processed/
wastewater_effluent_quality/python/data/processed/
industry_operations_cost/python/data/raw/
industry_operations_cost/python/data/processed/*
!industry_operations_cost/python/data/processed/lines_clean.csv
!industry_operations_cost/python/data/processed/monthly_costs_clean.csv
!industry_operations_cost/python/data/processed/production_log_clean.csv
# supply_chain_inventory/python/data/raw/ is deliberately NOT ignored: the
# dbt pipeline reads it as its source, so without it the models and their
# data-quality tests cannot run
supply_chain_inventory/python/data/processed/*
!supply_chain_inventory/python/data/processed/inventory_snapshots_clean.csv
!supply_chain_inventory/python/data/processed/products_clean.csv
!supply_chain_inventory/python/data/processed/purchase_orders_clean.csv
!supply_chain_inventory/python/data/processed/suppliers_clean.csv
