table lines
	lineageTag: 9a0bb6fd0abe8949f58bfaef239c4806

	partition lines = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:/Users/juanj/OneDrive/Documents/Data Analysis Projects/industry_operations_cost/python/data/processed/lines_clean.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
				in
				    PromotedHeaders

	column line_id
		dataType: int64
		summarizeBy: none
		sourceColumn: line_id

	column line_name
		dataType: string
		summarizeBy: none
		sourceColumn: line_name

	column area
		dataType: string
		summarizeBy: none
		sourceColumn: area

	column target_units_per_hour
		dataType: int64
		summarizeBy: none
		sourceColumn: target_units_per_hour
