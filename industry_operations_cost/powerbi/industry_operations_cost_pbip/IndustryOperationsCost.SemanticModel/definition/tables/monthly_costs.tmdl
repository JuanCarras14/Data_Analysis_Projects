table monthly_costs
	lineageTag: ac5a6a5adfcd05d23c3637d7422dd4cc

	partition monthly_costs = m
		let
		    Source = Csv.Document(File.Contents("C:/Users/juanj/OneDrive/Documents/Data Analysis Projects/industry_operations_cost/python/data/processed/monthly_costs_clean.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
		    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
		in
		    PromotedHeaders

	column cost_id
		dataType: int64
		summarizeBy: none
		sourceColumn: cost_id

	column line_id
		dataType: int64
		summarizeBy: none
		sourceColumn: line_id

	column cost_month
		dataType: string
		summarizeBy: none
		sourceColumn: cost_month

	column cost_type
		dataType: string
		summarizeBy: none
		sourceColumn: cost_type

	column amount
		dataType: decimal
		summarizeBy: none
		sourceColumn: amount

	measure 'Total Cost' = SUM(monthly_costs[amount])
		formatString: $#,0

	measure 'Cost per Unit' = DIVIDE([Total Cost], [Total Units])
		formatString: $0.00
