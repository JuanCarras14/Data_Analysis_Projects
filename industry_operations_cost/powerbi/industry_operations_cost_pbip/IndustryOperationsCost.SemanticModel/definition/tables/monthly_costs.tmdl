table monthly_costs
	lineageTag: 0275f645e9c45a97a9de9226bde34955

	partition monthly_costs = m
		let
		    Source = Csv.Document(File.Contents("C:/Users/juanj/OneDrive/Documents/Data Analysis Projects/industry_operations_cost/python/data/processed/monthly_costs_clean.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
		    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
		in
		    PromotedHeaders

	column cost_id
		dataType: int64
		summarizeBy: none
		sourceColumn: cost_id

	column line_id
		dataType: int64
		summarizeBy: none
		sourceColumn: line_id

	column cost_month
		dataType: string
		summarizeBy: none
		sourceColumn: cost_month

	column cost_type
		dataType: string
		summarizeBy: none
		sourceColumn: cost_type

	column amount
		dataType: decimal
		summarizeBy: none
		sourceColumn: amount

	measure 'Total Cost' = SUM(monthly_costs[amount])
		formatString: $#,0

	measure 'Cost per Unit' = DIVIDE([Total Cost], [Total Units])
		formatString: $0.00

	measure 'Materials Cost' = CALCULATE([Total Cost], monthly_costs[cost_type] = "Materials")
		formatString: $#,0

	measure 'Materials Share %' = DIVIDE([Materials Cost], [Total Cost])
		formatString: 0.0%

	measure 'Maintenance Cost' = CALCULATE([Total Cost], monthly_costs[cost_type] = "Maintenance")
		formatString: $#,0

	measure 'Maintenance Share %' = DIVIDE([Maintenance Cost], [Total Cost])
		formatString: 0.0%

	measure 'Highest Cost Type' = CONCATENATEX(TOPN(1, VALUES(monthly_costs[cost_type]), [Total Cost], DESC), monthly_costs[cost_type], ", ")
