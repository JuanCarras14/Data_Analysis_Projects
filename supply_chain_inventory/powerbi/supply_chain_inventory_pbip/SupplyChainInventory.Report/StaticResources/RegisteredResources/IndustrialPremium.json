{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.114.json",
  "name": "Industrial Premium",
  "dataColors": [
    "#1F4E79",
    "#2B7A78",
    "#D4602E",
    "#B9C3CF",
    "#6C7A89",
    "#3A6EA5",
    "#4E9C99",
    "#E0855C"
  ],
  "good": "#2B7A78",
  "neutral": "#B9C3CF",
  "bad": "#D4602E",
  "maximum": "#1F4E79",
  "center": "#B9C3CF",
  "minimum": "#F4F6F8",
  "null": "#E6EAEF",
  "background": "#F4F6F8",
  "backgroundLight": "#FFFFFF",
  "backgroundNeutral": "#E6EAEF",
  "backgroundDark": "#1F4E79",
  "foreground": "#404040",
  "firstLevelElements": "#404040",
  "secondLevelElements": "#6C7A89",
  "thirdLevelElements": "#E6EAEF",
  "fourthLevelElements": "#8A94A6",
  "shapeStroke": "#E6EAEF",
  "tableAccent": "#1F4E79",
  "hyperlink": "#1F4E79",
  "disabledText": "#B9C3CF",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#404040"
    },
    "largeTitle": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 14,
      "color": "#404040"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 10,
      "color": "#404040"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 30,
      "color": "#1F4E79"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#404040"
    },
    "boldLabel": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 9,
      "color": "#404040"
    },
    "lightLabel": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#6C7A89"
    },
    "smallLabel": {
      "fontFace": "Segoe UI",
      "fontSize": 8,
      "color": "#6C7A89"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E6EAEF"
              }
            },
            "width": 1,
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "preset": "BottomRight",
            "shadowBlur": 8,
            "shadowDistance": 2,
            "color": {
              "solid": {
                "color": "#5A6B7D"
              }
            },
            "transparency": 85
          }
        ],
        "padding": [
          {
            "top": 12,
            "bottom": 12,
            "left": 12,
            "right": 12
          }
        ],
        "title": [
          {
            "show": true,
            "alignment": "left",
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 11,
            "fontColor": {
              "solid": {
                "color": "#404040"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "subTitle": [
          {
            "show": false
          }
        ],
        "divider": [
          {
            "show": false
          }
        ],
        "outline": [
          {
            "transparency": 0
          }
        ],
        "visualHeader": [
          {
            "show": true,
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "border": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "foreground": {
              "solid": {
                "color": "#B9C3CF"
              }
            },
            "transparency": 0
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "gridlineShow": false,
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#6C7A89"
              }
            },
            "lineColor": {
              "solid": {
                "color": "#E6EAEF"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#6C7A89"
              }
            },
            "gridlineShow": true,
            "gridlineStyle": "solid",
            "gridlineThickness": 1,
            "gridlineColor": {
              "solid": {
                "color": "#E6EAEF"
              }
            }
          }
        ],
        "labels": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "color": {
              "solid": {
                "color": "#404040"
              }
            }
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "showTitle": false,
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#6C7A89"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F6F8"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F4F6F8"
              }
            },
            "transparency": 0
          }
        ],
        "displayArea": [
          {
            "verticalAlignment": "Top"
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 30,
            "color": {
              "solid": {
                "color": "#1F4E79"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "show": false
          }
        ],
        "wordWrap": [
          {
            "show": true
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "value": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 26,
            "color": {
              "solid": {
                "color": "#1F4E79"
              }
            }
          }
        ],
        "label": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 10,
            "color": {
              "solid": {
                "color": "#6C7A89"
              }
            }
          }
        ],
        "accentBar": [
          {
            "show": false
          }
        ],
        "outline": [
          {
            "show": false
          }
        ],
        "divider": [
          {
            "show": false
          }
        ]
      }
    },
    "multiRowCard": {
      "*": {
        "card": [
          {
            "outline": "None",
            "barShow": false
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "general": [
          {
            "outlineColor": {
              "solid": {
                "color": "#E6EAEF"
              }
            },
            "outlineWeight": 1
          }
        ],
        "header": [
          {
            "show": false
          }
        ],
        "items": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "fontColor": {
              "solid": {
                "color": "#404040"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E6EAEF"
              }
            },
            "gridHorizontalWeight": 1,
            "outlineColor": {
              "solid": {
                "color": "#E6EAEF"
              }
            },
            "outlineWeight": 1,
            "rowPadding": 6,
            "textSize": 9
          }
        ],
        "columnHeaders": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9,
            "outline": "BottomOnly",
            "fontColor": {
              "solid": {
                "color": "#404040"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "values": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "outline": "None",
            "fontColor": {
              "solid": {
                "color": "#404040"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "total": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9,
            "outline": "TopOnly",
            "fontColor": {
              "solid": {
                "color": "#1F4E79"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E6EAEF"
              }
            },
            "gridHorizontalWeight": 1,
            "outlineColor": {
              "solid": {
                "color": "#E6EAEF"
              }
            },
            "outlineWeight": 1,
            "rowPadding": 6,
            "textSize": 9
          }
        ],
        "columnHeaders": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9,
            "outline": "BottomOnly",
            "fontColor": {
              "solid": {
                "color": "#404040"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "rowHeaders": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "outline": "None",
            "fontColor": {
              "solid": {
                "color": "#404040"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "values": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "fontColor": {
              "solid": {
                "color": "#404040"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "shape": {
      "*": {
        "background": [
          {
            "show": false
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "background": [
          {
            "show": false
          }
        ]
      }
    }
  }
}