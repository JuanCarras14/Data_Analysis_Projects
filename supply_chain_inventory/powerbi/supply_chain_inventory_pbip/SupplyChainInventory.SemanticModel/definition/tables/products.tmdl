table products
	lineageTag: f1e73bbd713bb6bd081029b5fc5034c9

	partition products = m
		let
		    Source = Csv.Document(File.Contents("C:/Users/juanj/OneDrive/Documents/Data Analysis Projects/supply_chain_inventory/python/data/processed/products_clean.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
		    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
		in
		    PromotedHeaders

	column product_id
		dataType: int64
		summarizeBy: none
		sourceColumn: product_id

	column product_name
		dataType: string
		summarizeBy: none
		sourceColumn: product_name

	column category
		dataType: string
		summarizeBy: none
		sourceColumn: category

	column supplier_id
		dataType: int64
		summarizeBy: none
		sourceColumn: supplier_id

	column unit_cost
		dataType: decimal
		summarizeBy: none
		sourceColumn: unit_cost

	column reorder_point
		dataType: int64
