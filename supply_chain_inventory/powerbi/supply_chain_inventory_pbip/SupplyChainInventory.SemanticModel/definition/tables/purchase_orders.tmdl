table purchase_orders
	lineageTag: 7eeab15ca2a68ab8d5ebe36e1bbae8a9

	partition purchase_orders = m
		let
		    Source = Csv.Document(File.Contents("C:/Users/juanj/OneDrive/Documents/Data Analysis Projects/supply_chain_inventory/python/data/processed/purchase_orders_clean.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
		    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
		in
		    PromotedHeaders

	column po_id
		dataType: int64
		summarizeBy: none
		sourceColumn: po_id

	column product_id
		dataType: int64
		summarizeBy: none
		sourceColumn: product_id

	column supplier_id
		dataType: int64
		summarizeBy: none
		sourceColumn: supplier_id

	column order_date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: order_date

	column expected_delivery_date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: expected_delivery_date

	column actual_delivery_date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: actual_delivery_date

	column quantity_ordered
		dataType: int64
		summarizeBy: none
		sourceColumn: quantity_ordered

	measure 'Total Orders' = COUNTROWS(purchase_orders)
		formatString: #,0

	measure 'On-Time Orders' = CALCULATE(COUNTROWS(purchase_orders), purchase_orders[actual_delivery_date] <= purchase_orders[expected_delivery_date])
		formatString: #,0

	measure 'On-Time %' = DIVIDE([On-Time Orders], [Total Orders])
		formatString: 0.0%
