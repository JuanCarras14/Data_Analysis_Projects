table suppliers
	lineageTag: 28279bed987024ffdd22cfee0aa68bee

	partition suppliers = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:/Users/juanj/OneDrive/Documents/Data Analysis Projects/supply_chain_inventory/python/data/processed/suppliers_clean.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
				in
				    PromotedHeaders

	column supplier_id
		dataType: int64
		summarizeBy: none
		sourceColumn: supplier_id

	column supplier_name
		dataType: string
		summarizeBy: none
		sourceColumn: supplier_name

	column region
		dataType: string
		summarizeBy: none
		sourceColumn: region

	column nominal_lead_time_days
		dataType: int64
		summarizeBy: none
		sourceColumn: nominal_lead_time_days
